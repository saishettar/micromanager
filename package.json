{
  "name": "micromanager",
  "version": "0.1.0",
  "description": "A CLI linter that critiques your naming, not your logic.",
  "type": "module",
  "bin": {
    "micromanager": "./dist/cli.js"
  },
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "build:vscode": "npm run build && node scripts/bundle-vscode.mjs",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "src/roasts.json"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@babel/types": "^7.25.0",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.5.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
