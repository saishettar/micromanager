{
  "name": "micromanager-vscode",
  "displayName": "Micromanager",
  "description": "Roasts your bad variable names, right in the editor.",
  "version": "0.1.0",
  "publisher": "micromanager-dev",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Linters", "Other"],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "micromanager.relint",
        "title": "Micromanager: Relint Open Files"
      }
    ]
  }
}
